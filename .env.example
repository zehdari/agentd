# Copy to ~/agents/.env and fill in. Never commit .env.

# Bot token from https://discord.com/developers/applications -> your app -> Bot -> Reset Token
DISCORD_TOKEN=

# Optional: server ID (only needed if the bot is in more than one server)
DISCORD_GUILD_ID=

# Optional: extra Discord user IDs allowed to control agents (comma-separated).
# The bot application's owner (you) is always allowed.
AGENTD_OWNER_IDS=

# Optional: where agents start when no directory is given (default: ~)
AGENTD_DEFAULT_DIR=~

# Optional: default model for new agents (fable, opus, sonnet, haiku); blank = Claude Code default
AGENTD_DEFAULT_MODEL=

# Optional: default thinking effort for new agents (low, medium, high, xhigh, max); blank = Claude Code default
AGENTD_DEFAULT_EFFORT=

# Optional: localhost port for hooks and agentd-send
AGENTD_PORT=8765

# Optional: web dashboard port (0 turns it off). Reachable from this machine and your own Tailscale devices.
AGENTD_WEB_PORT=8780
