#!/usr/bin/env python3
"""Send files and/or a message to Discord: the calling agent's thread, or #alerts."""
import argparse
import json
import os
import sys
import urllib.error
import urllib.request

parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument("files", nargs="*", help="files to upload (screenshots, plots, logs...)")
parser.add_argument("-m", "--message", default="", help="text to post with the files")
parser.add_argument("--alert", action="store_true", help="also ping the user's phone via #alerts")
args = parser.parse_args()
if not args.files and not args.message:
    parser.error("nothing to send")

files = [os.path.abspath(f) for f in args.files]
missing = [f for f in files if not os.path.isfile(f)]
if missing:
    sys.exit(f"not a file: {', '.join(missing)}")

body = {"thread_id": os.environ.get("AGENTD_THREAD_ID"), "files": files,
        "message": args.message, "alert": args.alert}
request = urllib.request.Request(
    f"http://127.0.0.1:{os.environ.get('AGENTD_PORT', '8765')}/send",
    data=json.dumps(body).encode(), headers={"Content-Type": "application/json"})
try:
    with urllib.request.urlopen(request, timeout=120) as response:
        print("sent")
except urllib.error.HTTPError as e:
    sys.exit(json.loads(e.read() or b"{}").get("error", f"HTTP {e.code}"))
except OSError as e:
    sys.exit(f"agentd is not reachable: {e}")
